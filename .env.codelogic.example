# Copy to ".env.codelogic" (gitignored). Used by scripts/codelogic/run-*-scan.sh
#
# CodeLogic Admin → Installers for CODELOGIC_HOST, AGENT_UUID, AGENT_PASSWORD.

CODELOGIC_HOST=https://YOUR_INSTANCE.app.codelogic.com/codelogic/server/
AGENT_UUID=
AGENT_PASSWORD=

CODELOGIC_DOTNET_IMAGE=thingsboard.app.codelogic.com/codelogic_dotnet:latest
CODELOGIC_SQL_IMAGE=thingsboard.app.codelogic.com/codelogic_sql:latest

# dotnet publish output (layout like CI artifacts/out). Scanned with -p /app inside the agent.
CODELOGIC_PUBLISH_PATH=./artifacts/out

# Optional: mount host .NET "shared" refs (Linux). GitHub Actions uses /usr/share/dotnet.
CODELOGIC_REF_DOTNET_HOST=

# One database identity per line (NodeDetails). Passed as multiple -d flags.
CODELOGIC_DATABASE_IDENTITIES=

CODELOGIC_APPLICATION=ModularMonolith
CODELOGIC_SCAN_SPACE=ModularMonolith

# SQL agent: attach to Compose network so JDBC host mymeetingsdb resolves (docker network ls).
CODELOGIC_DOCKER_NETWORK=modular-monolith-with-ddd_starfish-crm-network

CODELOGIC_SQL_JDBC_URL=jdbc:sqlserver://mymeetingsdb:1433;databaseName=MyMeetings;encrypt=false;trustServerCertificate=true
CODELOGIC_SQL_USER=sa
CODELOGIC_SQL_PASSWORD=Test@12345
CODELOGIC_SQL_SCAN_SPACE=ModularMonolith-sql
CODELOGIC_SQL_EXPUNGE_SCAN_SESSIONS=0
