# Copy to ".env.codelogic" (gitignored) and fill in values from CodeLogic Admin → Installers.
#
# Always pass Compose interpolation vars (publish path, images) via:
#   docker compose --env-file .env.codelogic ...
#
# Official SQL agent image name is "codelogic_sql" (registry host comes from your installer).

CODELOGIC_HOST=https://YOUR_INSTANCE.app.codelogic.com/codelogic/server/
AGENT_UUID=
AGENT_PASSWORD=

# Registry prefix for agent images (must match your installer snippet).
CODELOGIC_DOTNET_IMAGE=thingsboard.app.codelogic.com/codelogic_dotnet:latest
CODELOGIC_SQL_IMAGE=thingsboard.app.codelogic.com/codelogic_sql:latest

# Folder with dotnet publish output (same layout as CI PUBLISH_OUTPUT). Mounted read-only at /app in the agent.
CODELOGIC_PUBLISH_PATH=./artifacts/out

# One database identity per line (from UI NodeDetails). Example for SQL Server:
# jdbc:sqlserver://mymeetingsdb:1433;databaseName=MyMeetings;encrypt=false;trustServerCertificate=true
CODELOGIC_DATABASE_IDENTITIES=

CODELOGIC_APPLICATION=ModularMonolith
CODELOGIC_SCAN_SPACE=ModularMonolith
CODELOGIC_EXPUNGE_SCAN_SESSIONS=1

# SQL agent: JDBC URL only (no user/password in URL when using separate -u/-pwd).
CODELOGIC_SQL_JDBC_URL=jdbc:sqlserver://mymeetingsdb:1433;databaseName=MyMeetings;encrypt=false;trustServerCertificate=true
CODELOGIC_SQL_USER=sa
CODELOGIC_SQL_PASSWORD=Test@12345
CODELOGIC_SQL_SCAN_SPACE=ModularMonolith-sql
CODELOGIC_SQL_EXPUNGE_SCAN_SESSIONS=0
