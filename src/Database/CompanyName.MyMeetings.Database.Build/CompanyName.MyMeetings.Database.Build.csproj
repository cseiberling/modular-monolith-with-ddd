<Project Sdk="MSBuild.Sdk.SqlProj/2.6.1">
  <PropertyGroup>
    <SqlServerVersion>Sql130</SqlServerVersion>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <DeployOnBuild>false</DeployOnBuild>
    <!-- dotnet publish invokes SqlProj Publish target; keep CI from targeting a SQL Server -->
    <DeployOnPublish>False</DeployOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\CompanyName.MyMeetings.Database\Structure\**\*.sql" />
  </ItemGroup>
</Project>
